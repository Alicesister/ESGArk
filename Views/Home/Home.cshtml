@{
    ViewBag.Title = "EcoTrack";
}

<!-- 首屏區 (Hero Section) -->
<div class="jumbotron text-center bg-success text-white p-5 mb-4 rounded-3">
    <h1 class="display-4">EcoTrack Commons</h1>
    <p class="lead">ESG 永續生活方式，從你我開始</p>
    <a href="#features" class="btn btn-light btn-lg m-2">開始體驗</a>
    <a href="@Url.Action("About", "Home")" class="btn btn-outline-light btn-lg m-2">瞭解更多</a>
</div>

<!-- 專案介紹區 -->
<div class="container my-5">
    <h2 class="text-success mb-3">專案介紹</h2>
    <p>
        隨著全球 ESG 議題受到重視，EcoTrack 提供一個讓使用者學習並實踐永續生活的平台。
        我們希望幫助大眾理解 ESG，透過碳足跡計算機與智能建議，引導具體的永續行動。
    </p>
</div>

<!-- 核心功能區 -->
<div id="features" class="container my-5">
    <h2 class="text-success mb-3">核心功能</h2>
    <div class="row g-4">
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">智能碳足跡計算</h5>
                    <p class="card-text">涵蓋交通、能源、飲食、消費行為分析，快速生成個人碳足跡報告。</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">永續行動紀錄</h5>
                    <p class="card-text">記錄減塑、綠色交通、參與社區活動，幫助追蹤與激勵持續行動。</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">個人化建議</h5>
                    <p class="card-text">根據使用者數據，提供具體改善方案，協助逐步減碳。</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">學習模組</h5>
                    <p class="card-text">互動案例研究與實作模組，讓 ESG 知識更容易理解與應用。</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 優勢亮點區 -->
<div class="container my-5">
    <h2 class="text-success mb-3">市場與優勢</h2>
    <ul>
        <li>低成本運營</li>
        <li>跨平台便利性</li>
        <li>智能推薦</li>
    </ul>
    <p class="mt-3">潛在應用：家庭永續計畫、教育推廣、企業 ESG 工具</p>
</div>

<!-- 團隊介紹區 -->
<div class="container my-5">
    <h2 class="text-success mb-3">團隊介紹</h2>
    <div class="row g-3">
        <div class="col-md-3"><div class="border p-3 text-center">司毓文</div></div>
        <div class="col-md-3"><div class="border p-3 text-center">褚俊儒</div></div>
        <div class="col-md-3"><div class="border p-3 text-center">陳伃豊</div></div>
        <div class="col-md-3"><div class="border p-3 text-center">程子浡</div></div>
        <div class="col-md-3"><div class="border p-3 text-center">陳欣宜</div></div>
        <div class="col-md-3"><div class="border p-3 text-center">林奕君</div></div>
        <div class="col-md-3"><div class="border p-3 text-center">蔡宜閎</div></div>
        <div class="col-md-3"><div class="border p-3 text-center">莊紹岐</div></div>
    </div>
</div>

<!-- Call to Action 區 -->
<div class="container text-center my-5">
    <h2 class="mb-3">一起成為改變世界的一份子！</h2>
    <a href="#features" class="btn btn-success btn-lg">立即試用碳足跡計算機</a>
</div>
