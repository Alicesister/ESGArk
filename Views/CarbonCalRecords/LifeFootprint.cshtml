@{
    ViewBag.Title = "生活碳足跡計算";
    Layout = "~/Views/Shared/_Layout.cshtml"; // 使用你給的 layout
}

<h2 class="mt-4">生活碳足跡計算</h2>

@using (Html.BeginForm("Create", "CarbonCalRecords", FormMethod.Post))
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <div class="form-group">
        @Html.Label("使用者 ID", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="number" name="UserId" class="form-control" required />
        </div>
    </div>

    <div class="form-group">
        @Html.Label("行為類型", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <select name="BehaviorType" class="form-control" required>
                <option value="交通">交通</option>
                <option value="飲食">飲食</option>
                <option value="電梯">電梯</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        @Html.Label("子類型", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <select name="SubType" class="form-control" required>
                <option value="開車">開車</option>
                <option value="高鐵">高鐵</option>
                <option value="公車">公車</option>
                <option value="牛肉">牛肉</option>
                <option value="素食">素食</option>
                <option value="電梯">電梯</option>
            </select>
        </div>
    </div>

    <div class="form-group">
        @Html.Label("數量", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="number" name="Quantity" class="form-control" step="0.01" required />
        </div>
    </div>

    <div class="form-group">
        @Html.Label("單位", htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <input type="text" name="Unit" class="form-control" placeholder="如：公里、次、份" required />
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10 mt-3">
            <input type="submit" value="計算並儲存" class="btn btn-success" />
        </div>
    </div>
</div>
}
