<!DOCTYPE html>
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - ESG 永續生活方舟</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
</head>
<body>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-dark">
        <div class="container">
            @Html.ActionLink("ESG 永續生活方舟-會員專區", "Index", "Member", new { area = "" }, new { @class = "navbar-brand" })
            <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="切換導覽" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li>@Html.ActionLink("ESG及功能介紹", "Index", "Member", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("生活碳足跡計算", "ShoppingCar", "Member", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("碳足跡追蹤功能", "OrderList", "Member", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("碳足跡報告生成", "OrderList", "Member", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("遊戲化機制", "OrderList", "Member", new { area = "" }, new { @class = "nav-link" })</li>
                    <li>@Html.ActionLink("登出", "Logout", "Member", new { area = "" }, new { @class = "nav-link" })</li>
                    <li><span style="color:white">@Session["Welcome"]</span></li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - ESG關心您</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>
